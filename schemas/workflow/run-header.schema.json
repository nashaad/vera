{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://vera.dev/schemas/workflow/run-header.schema.json",
    "title": "Vera workflow run header",
    "type": "object",
    "required": [
        "run_id",
        "workflow",
        "status",
        "started_at",
        "inbox",
        "doc"
    ],
    "properties": {
        "run_id": {
            "type": "string",
            "pattern": "^wf_[0-9a-f]{16}$"
        },
        "workflow": {
            "type": "string",
            "minLength": 1
        },
        "status": {
            "enum": ["ok", "failed", "suspended", "cancelled", "running"]
        },
        "started_at": {
            "type": "string",
            "format": "date-time"
        },
        "finished_at": {
            "type": "string",
            "format": "date-time"
        },
        "inbox": {
            "type": "object"
        },
        "doc": {
            "type": "string"
        },
        "args": {
            "type": "array"
        },
        "kwargs": {
            "type": "object"
        },
        "error": {
            "type": "object",
            "required": ["kind", "message"],
            "properties": {
                "kind": { "type": "string" },
                "message": { "type": "string" }
            },
            "additionalProperties": false
        },
        "reason": {
            "type": "string"
        },
        "cancel_requested": {
            "type": "string"
        },
        "active": {
            "type": "object",
            "required": ["key", "step", "at"],
            "additionalProperties": false,
            "properties": {
                "key": { "type": "string", "minLength": 1 },
                "step": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "format": "date-time" }
            }
        },
        "attempts": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["started_at", "pid", "host"],
                "additionalProperties": false,
                "properties": {
                    "started_at": { "type": "string", "format": "date-time" },
                    "pid": { "type": "integer", "minimum": 0 },
                    "host": { "type": "string" },
                    "finished_at": { "type": "string", "format": "date-time" },
                    "status": {
                        "enum": ["ok", "failed", "suspended", "cancelled"]
                    },
                    "error": {
                        "type": "object",
                        "required": ["kind", "message"],
                        "additionalProperties": false,
                        "properties": {
                            "kind": { "type": "string" },
                            "message": { "type": "string" }
                        }
                    }
                }
            }
        },
        "entry": {
            "type": "object",
            "required": ["file", "workflow", "cwd"],
            "additionalProperties": false,
            "properties": {
                "file": { "type": "string", "minLength": 1 },
                "workflow": { "type": "string", "minLength": 1 },
                "cwd": { "type": "string", "minLength": 1 }
            }
        }
    },
    "additionalProperties": false
}
