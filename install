#!/bin/sh
# Install a Vera release archive without requiring a checkout or Bun.
#
# The release contract is one archive per platform, named
# vera-<platform>-<arch>.tar.gz, plus a .sha256 sidecar. The archive contains
# VERSION, manifest.json, and an executable at bin/vera.
set -eu

umask 077

die() {
    echo "vera install: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

require_command curl
require_command tar

home=${HOME:-}
[ -n "$home" ] || die "HOME is not set"

repository=${VERA_INSTALL_REPOSITORY:-nashaad/vera}
version=${VERA_INSTALL_VERSION:-latest}
release_base=${VERA_INSTALL_BASE_URL:-https://github.com/$repository/releases}
install_root=${VERA_INSTALL_ROOT:-${XDG_DATA_HOME:-$home/.local/share}/vera}
bin_dir=${VERA_INSTALL_BIN_DIR:-${XDG_BIN_HOME:-$home/.local/bin}}

platform=${VERA_INSTALL_PLATFORM:-}
if [ -z "$platform" ]; then
    case "$(uname -s)" in
        Darwin) platform=darwin ;;
        Linux) platform=linux ;;
        *) die "unsupported operating system: $(uname -s)" ;;
    esac
fi

arch=${VERA_INSTALL_ARCH:-}
if [ -z "$arch" ]; then
    case "$(uname -m)" in
        arm64|aarch64) arch=arm64 ;;
        x86_64|amd64) arch=x64 ;;
        *) die "unsupported architecture: $(uname -m)" ;;
    esac
fi

case "$platform/$arch" in
    darwin/arm64|darwin/x64|linux/arm64|linux/x64) ;;
    *) die "unsupported Vera release target: $platform/$arch" ;;
esac

case "$version" in
    latest) ;;
    v[0-9]*|[0-9]*)
        case "$version" in
            *[!A-Za-z0-9._+-]*) die "invalid Vera version: $version" ;;
        esac
        ;;
    *) die "invalid Vera version: $version" ;;
esac

archive_name="vera-$platform-$arch.tar.gz"
case "$version" in
    latest) release_asset_path="latest/download" ;;
    *) release_asset_path="download/$version" ;;
esac
archive_url="$release_base/$release_asset_path/$archive_name"
checksum_url="$archive_url.sha256"

case "$release_base" in
    https://*) curl_security_args="--proto =https --tlsv1.2" ;;
    http://*)
        [ "${VERA_INSTALL_ALLOW_INSECURE_HTTP:-}" = "1" ] \
            || die "refusing insecure HTTP release URL; use HTTPS"
        curl_security_args=""
        ;;
    file://*)
        [ "${VERA_INSTALL_ALLOW_FILE:-}" = "1" ] \
            || die "refusing local file release URL"
        curl_security_args=""
        ;;
    *) die "release URL must use HTTPS" ;;
esac

mkdir -p "$install_root/versions" "$bin_dir"
staging="$install_root/.staging.$$.${RANDOM:-0}"
mkdir "$staging"
cleanup() {
    rm -rf "$staging"
}
trap cleanup EXIT HUP INT TERM

download() {
    url=$1
    destination=$2
    # shellcheck disable=SC2086
    curl $curl_security_args --fail --location --retry 3 \
        --silent --show-error "$url" -o "$destination"
}

echo "Downloading Vera $version for $platform/$arch..."
download "$archive_url" "$staging/$archive_name"
download "$checksum_url" "$staging/$archive_name.sha256"

expected_checksum=$(awk 'NF { print $1; exit }' "$staging/$archive_name.sha256")
case "$expected_checksum" in
    ""|*[!0123456789abcdefABCDEF]*)
        die "invalid SHA-256 sidecar for $archive_name"
        ;;
esac
[ "${#expected_checksum}" -eq 64 ] \
    || die "invalid SHA-256 length for $archive_name"

if command -v shasum >/dev/null 2>&1; then
    actual_checksum=$(shasum -a 256 "$staging/$archive_name" | awk '{ print $1 }')
elif command -v sha256sum >/dev/null 2>&1; then
    actual_checksum=$(sha256sum "$staging/$archive_name" | awk '{ print $1 }')
else
    die "required command not found: shasum or sha256sum"
fi

[ "$actual_checksum" = "$expected_checksum" ] \
    || die "SHA-256 verification failed for $archive_name"

archive_root="$staging/unpacked"
mkdir "$archive_root"

# Reject obvious archive traversal before extraction. Release archives are
# produced by us, but the installer must not turn a compromised asset into a
# write outside its staging directory.
tar -tzf "$staging/$archive_name" > "$staging/archive.list"
while IFS= read -r member || [ -n "$member" ]; do
    member=${member#./}
    case "$member" in
        "") continue ;;
        /*|..|../*|*/../*|*/..)
            die "unsafe path in release archive: $member"
            ;;
    esac
done < "$staging/archive.list"

tar -xzf "$staging/$archive_name" -C "$archive_root"
[ -f "$archive_root/VERSION" ] \
    || die "release archive is missing VERSION"
[ -s "$archive_root/manifest.json" ] \
    || die "release archive is missing manifest.json"
[ -f "$archive_root/bin/vera" ] \
    || die "release archive is missing bin/vera"
[ -x "$archive_root/bin/vera" ] \
    || die "release archive bin/vera is not executable"

# A release bundle is self-contained; symlinks would let an archive escape the
# version directory after activation.
if find "$archive_root" -type l -print -quit | grep . >/dev/null 2>&1; then
    die "release archive contains a symlink"
fi

installed_version=$(tr -d '\r\n' < "$archive_root/VERSION")
case "$installed_version" in
    ""|.|..|*[!A-Za-z0-9._+-]*|*/*)
        die "invalid VERSION in release archive: $installed_version"
        ;;
esac

manifest_value() {
    key=$1
    sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\([^\"]*\)\".*/\1/p" \
        "$archive_root/manifest.json" | sed -n '1p'
}

manifest_version=$(manifest_value version)
[ "$manifest_version" = "$installed_version" ] \
    || die "manifest version does not match VERSION"
manifest_platform=$(manifest_value platform)
[ "$manifest_platform" = "$platform" ] \
    || die "manifest platform does not match installer target"
manifest_arch=$(manifest_value architecture)
[ "$manifest_arch" = "$arch" ] \
    || die "manifest architecture does not match installer target"

case "$version" in
    latest) ;;
    v*) [ "${installed_version#v}" = "${version#v}" ] \
        || die "release VERSION $installed_version does not match $version" ;;
    *) [ "$installed_version" = "$version" ] \
        || die "release VERSION $installed_version does not match $version" ;;
esac

current="$install_root/current"
if [ -e "$current" ] || [ -L "$current" ]; then
    [ -L "$current" ] || die "refusing to replace non-Vera path: $current"
    existing_current=$(readlink "$current" || true)
    case "$existing_current" in
        versions/*|"$install_root"/*) ;;
        *) die "refusing to replace current owned by another install: $current" ;;
    esac
fi

bin_path="$bin_dir/vera"
if [ -e "$bin_path" ] || [ -L "$bin_path" ]; then
    [ -L "$bin_path" ] || die "refusing to replace existing executable: $bin_path"
    existing_target=$(readlink "$bin_path" || true)
    case "$existing_target" in
        "$install_root"/*|../share/vera/*) ;;
        *) die "refusing to replace executable owned by another install: $bin_path" ;;
    esac
fi

target="$install_root/versions/$installed_version"
if [ -e "$target" ] || [ -L "$target" ]; then
    [ -f "$target/VERSION" ] && [ -x "$target/bin/vera" ] \
        || die "existing Vera version is incomplete: $target"
    rm -rf "$archive_root"
else
    chmod 755 "$archive_root/bin/vera"
    mv "$archive_root" "$target"
fi

current_tmp="$install_root/.current.$$.tmp"
rm -f "$current_tmp"
ln -s "versions/$installed_version" "$current_tmp"
mv -f "$current_tmp" "$current"

bin_tmp="$bin_dir/.vera.$$.tmp"
rm -f "$bin_tmp"
ln -s "$install_root/current/bin/vera" "$bin_tmp"
mv -f "$bin_tmp" "$bin_path"

echo "Installed Vera $installed_version at $target"
echo "Executable: $bin_path"
case ":${PATH:-}:" in
    *:"$bin_dir":*) ;;
    *) echo "Add $bin_dir to PATH to run 'vera' directly." ;;
esac
