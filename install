#!/bin/sh
# Install Vera from npm into a user-owned prefix without mutating a working
# installation until the replacement has passed its CLI check.
set -eu

die() {
    echo "vera install: $*" >&2
    exit 1
}

require_command() {
    command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

for command in awk bun grep mktemp npm readlink; do
    require_command "$command"
done

home=${HOME:-}
[ -n "$home" ] || die "HOME is not set"

bin_override=${VERA_INSTALL_BIN_DIR:-${XDG_BIN_HOME:-}}
if [ -n "${VERA_INSTALL_PREFIX:-}" ]; then
    prefix=$VERA_INSTALL_PREFIX
elif [ -n "$bin_override" ]; then
    case "$bin_override" in
        /*/bin) prefix=${bin_override%/bin} ;;
        *) die "custom bin directory must end in /bin; set VERA_INSTALL_PREFIX instead" ;;
    esac
else
    prefix=$home/.local
fi
case "$prefix" in
    /*) ;;
    *) die "install prefix must be an absolute path: $prefix" ;;
esac
case "$prefix" in
    /|/bin|/usr|/usr/local) die "refusing unsafe install prefix: $prefix" ;;
esac

package=${VERA_NPM_PACKAGE:-@nashaad/vera}
version=${VERA_INSTALL_VERSION:-latest}
registry=${VERA_NPM_REGISTRY:-https://registry.npmjs.org}
case "$registry" in
    https://*) ;;
    *) die "npm registry must use HTTPS: $registry" ;;
esac

case "$version" in
    latest) ;;
    v[0-9]*|[0-9]*)
        version=${version#v}
        printf '%s\n' "$version" \
            | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' \
            || die "invalid stable Vera version: $version"
        ;;
    *) die "invalid Vera version: $version" ;;
esac

case "$package" in
    @nashaad/vera) package_spec="$package@$version" ;;
    *)
        [ -n "${VERA_NPM_PACKAGE:-}" ] \
            || die "custom package sources require VERA_NPM_PACKAGE"
        package_spec=$package
        ;;
esac

bun_version=$(bun --version 2>/dev/null || true)
printf '%s\n' "$bun_version" \
    | grep -Eq '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' \
    || die "could not determine Bun version"
if ! printf '%s\n' "$bun_version" | awk -F. '
    $1 > 1 { ok = 1 }
    $1 == 1 && $2 > 3 { ok = 1 }
    $1 == 1 && $2 == 3 && $3 >= 6 { ok = 1 }
    END { exit ok ? 0 : 1 }
'; then
    die "Bun 1.3.6 or newer is required; found $bun_version"
fi

if [ "$(uname -s)" = "Linux" ]; then
    libc=$(getconf GNU_LIBC_VERSION 2>/dev/null || true)
    case "$libc" in
        glibc\ *) ;;
        *) die "Vera's current Linux package requires glibc" ;;
    esac
fi

for path in "$prefix" "$prefix/bin" "$prefix/lib" "$prefix/lib/node_modules"; do
    [ -L "$path" ] && die "refusing symlinked install path: $path"
done
mkdir -p "$prefix/bin" "$prefix/lib/node_modules/@nashaad"

bin_path=$prefix/bin/vera
package_path=$prefix/lib/node_modules/@nashaad/vera
expected_npm_link=../lib/node_modules/@nashaad/vera/bin/vera
legacy_root=${VERA_LEGACY_INSTALL_ROOT:-${XDG_DATA_HOME:-$home/.local/share}/vera}

shadow=$(command -v vera 2>/dev/null || true)
if [ -n "$shadow" ] && [ "$shadow" != "$bin_path" ]; then
    die "another Vera command shadows this install: $shadow (target is $bin_path)"
fi

if [ -e "$bin_path" ] || [ -L "$bin_path" ]; then
    [ -L "$bin_path" ] || die "refusing to replace existing Vera executable: $bin_path"
    existing_target=$(readlink "$bin_path")
    case "$existing_target" in
        "$legacy_root/current/bin/vera"|\
        "$expected_npm_link"|\
        "$package_path/bin/vera") ;;
        *) die "refusing to replace existing Vera executable: $bin_path" ;;
    esac
fi

lock_dir=$prefix/.vera-install.lock
if ! mkdir "$lock_dir" 2>/dev/null; then
    lock_pid=$(tr -d '\r\n' < "$lock_dir/pid" 2>/dev/null || true)
    case "$lock_pid" in
        ""|*[!0-9]*) die "another Vera install is running; remove $lock_dir if stale" ;;
    esac
    if kill -0 "$lock_pid" 2>/dev/null; then
        die "another Vera install is running; remove $lock_dir if stale"
    fi
    stale_lock=$prefix/.vera-install.stale.$$
    mv "$lock_dir" "$stale_lock" 2>/dev/null \
        || die "another Vera install started while clearing a stale lock"
    mkdir "$lock_dir" 2>/dev/null \
        || die "another Vera install started while clearing a stale lock"
    rm -rf "$stale_lock"
fi
printf '%s\n' "$$" > "$lock_dir/pid"

stage=$(mktemp -d "$prefix/.vera-install.XXXXXX")
package_backup=$prefix/lib/node_modules/@nashaad/.vera.backup.$$
bin_backup=$prefix/bin/.vera.backup.$$
package_promoted=0
bin_promoted=0
install_succeeded=0

cleanup() {
    if [ "$install_succeeded" -ne 1 ]; then
        if [ "$bin_promoted" -eq 1 ]; then
            rm -f "$bin_path"
            if [ -e "$bin_backup" ] || [ -L "$bin_backup" ]; then
                mv "$bin_backup" "$bin_path"
            fi
        fi
        if [ "$package_promoted" -eq 1 ]; then
            rm -rf "$package_path"
            if [ -d "$package_backup" ]; then
                mv "$package_backup" "$package_path"
            fi
        fi
    fi
    rm -rf "$stage"
    rm -rf "$package_backup"
    rm -f "$bin_backup"
    rm -rf "$lock_dir"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

echo "Staging Vera $version from npm..."
npm install --global --ignore-scripts --bin-links=true \
    --registry "$registry" --prefix "$stage/prefix" -- "$package_spec"

staged_package=$stage/prefix/lib/node_modules/@nashaad/vera
staged_bin=$stage/prefix/bin/vera
[ -d "$staged_package" ] || die "npm package has the wrong name or layout"
[ -x "$staged_bin" ] || die "npm did not create the Vera executable"

installed_version=$(
    HOME="$home" VERA_HOME=${VERA_HOME:-$home/.vera} \
        VERA_RELEASE_VERSION= "$staged_bin" --version
) || die "staged Vera executable failed its version check"
case "$version" in
    latest)
        printf '%s\n' "$installed_version" \
            | grep -Eq '^vera (0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$' \
            || die "staged Vera returned an invalid version: $installed_version"
        ;;
    *)
        [ "$installed_version" = "vera $version" ] \
            || die "staged Vera version does not match $version: $installed_version"
        ;;
esac

[ ! -e "$package_backup" ] || die "package backup path already exists"
if [ -e "$package_path" ]; then
    [ -d "$package_path" ] && [ ! -L "$package_path" ] \
        || die "refusing to replace non-package path: $package_path"
    mv "$package_path" "$package_backup"
fi
mv "$staged_package" "$package_path"
package_promoted=1

if [ -e "$bin_path" ] || [ -L "$bin_path" ]; then
    mv "$bin_path" "$bin_backup"
fi
bin_promoted=1
bin_tmp=$prefix/bin/.vera.$$.tmp
rm -f "$bin_tmp"
ln -s "$expected_npm_link" "$bin_tmp"
mv -f "$bin_tmp" "$bin_path"

final_version=$(
    HOME="$home" VERA_HOME=${VERA_HOME:-$home/.vera} \
        VERA_RELEASE_VERSION= "$bin_path" --version
) || die "installed Vera executable failed its final version check"
[ "$final_version" = "$installed_version" ] \
    || die "installed Vera changed version during activation"

install_succeeded=1
echo "Installed $final_version"
echo "Executable: $bin_path"
case ":${PATH:-}:" in
    *:"$prefix/bin":*) ;;
    *) echo "Add $prefix/bin to PATH to run 'vera' directly." ;;
esac
