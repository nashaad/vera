{
  "name": "vera",
  "module": "index.ts",
  "bin": {
    "vera": "./clients/cli/main.ts"
  },
  "type": "module",
  "private": true,
  "scripts": {
    "dev:manual": "bash docs/site/run",
    "start": "bun run clients/stdio/main.ts",
    "pack:web": "bun run scripts/pack-web.ts dist/release/annex",
    "pack:release": "bun run scripts/pack-release.ts dist/release",
    "install:local": "bun run scripts/install-local.ts",
    "host": "bun run pack:release && bun run clients/host/main.ts",
    "tui": "bun run pack:release && bun run clients/tui/main.ts",
    "dev:sweep": "bun scripts/dev-sweep.ts",
    "dev:tui": "bun run pack:release && bun run scripts/dev-tui.ts",
    "factory:home": "bun run scripts/synthesize-factory-home.ts",
    "smoke:openrouter": "bun run scripts/openrouter-smoke.ts",
    "models:discover": "bun run scripts/verify-model-catalog.ts --discover",
    "models:verify": "bun run scripts/verify-model-catalog.ts",
    "smoke:codex": "bun run scripts/codex-smoke.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "typescript": "^5"
  },
  "dependencies": {
    "@openrouter/sdk": "^0.13.55",
    "@opentui/core": "^0.2.6",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "htmlparser2": "^12.0.0",
    "marked": "^17.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.3",
    "trash": "10.1.1",
    "tree-sitter-bash": "0.25.1",
    "undici": "6.21.3",
    "unpdf": "^1.8.0",
    "web-tree-sitter": "0.25.10"
  }
}
