#!/bin/sh
# Answers the one URL Vera's install command fetches. Everything else is the real curl.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for argument in "$@"; do
    case "$argument" in
    *get.corvines.com/install.sh)
        repo=$(CDPATH= cd -- "$here/../.." && pwd)
        sed "s|@REPO@|$repo|g" "$here/install.sh"
        exit 0
        ;;
    esac
done
exec /usr/bin/curl "$@"
