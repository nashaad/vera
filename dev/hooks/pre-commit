#!/bin/sh
#
# Keep the engine frozen unless a maintainer approved the exact staged change.

if ! protected_paths=$(git diff --cached --name-only --no-renames -- \
    'src/engine/**' 'test/engine/**'); then
    printf 'pre-commit: could not inspect staged engine changes; refusing commit\n' >&2
    exit 1
fi

[ -n "$protected_paths" ] || exit 0

if ! protected_state=$(git diff --cached --raw --no-abbrev --no-renames -- \
    'src/engine/**' 'test/engine/**'); then
    printf 'pre-commit: could not fingerprint staged engine changes; refusing commit\n' >&2
    exit 1
fi

if ! approval=$(printf '%s\n' "$protected_state" | git hash-object --stdin); then
    printf 'pre-commit: could not fingerprint staged engine changes; refusing commit\n' >&2
    exit 1
fi

if [ "${VERA_ENGINE_CHANGE_APPROVAL:-}" = "$approval" ]; then
    exit 0
fi

printf 'pre-commit: engine changes require explicit maintainer approval\n\n' >&2
printf '%s\n' "$protected_paths" | sed 's/^/  /' >&2
printf '\nNew capabilities belong in extensions by default. Show a maintainer the\n' >&2
printf 'exact staged engine diff with:\n\n' >&2
printf '  git diff --cached -- src/engine test/engine\n\n' >&2
printf 'Generic approval such as "continue" does not count. After a maintainer approves\n' >&2
printf 'that diff, retry once with:\n\n' >&2
printf '  VERA_ENGINE_CHANGE_APPROVAL=%s git commit ...\n\n' "$approval" >&2
printf 'Any staged engine change produces a different approval value.\n\n' >&2
exit 1
